NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Local dev uses docker-compose Postgres
DATABASE_URL=postgresql://sabo:sabo_password@localhost:5433/sabo_finance?sslmode=disable
DATABASE_URL_TEST=postgresql://sabo:sabo_password@localhost:5433/sabo_finance_test?sslmode=disable
REDIS_URL=redis://localhost:6379

JWT_SECRET=change_me_access
JWT_REFRESH_SECRET=

# SMTP Configuration
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=change_me_refresh
SUPPORT_EMAIL=support@sabofinance.com

FLUTTERWAVE_SECRET=FLWSECK_TEST-xxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_hash

FX_API_KEY=

# Either set CLOUDINARY_URL, or later switch to S3
CLOUDINARY_URL=

API_BASE_URL=http://localhost:3000
WEBSITE_URL=https://sabofinance.com
